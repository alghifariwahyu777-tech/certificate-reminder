# --- Database (PostgreSQL / Supabase) ---
# From Supabase dashboard -> your project -> "Connect":
#   DATABASE_URL = "Transaction" pooler connection string (port 6543) — used
#                   for normal app queries, safe for serverless.
#   DIRECT_URL   = "Direct connection" string (port 5432) — used only when
#                   running `npx prisma migrate`, since DDL doesn't work
#                   reliably through the pooler.
# Replace [YOUR-PASSWORD] with your actual database password in both.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xxxx.pooler.supabase.com:5432/postgres"
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# --- Document Storage (Google Drive) ---
# Certificate/renewal documents are uploaded to a Google Drive folder via a
# service account, then proxied to users through /api/files/[fileId] (so the
# Drive file itself stays private — access is gated by app login, for both
# internal users and Client Portal users).
#
# Setup: create a Google Cloud project, enable the "Google Drive API", create
# a Service Account, download its JSON key, create a Drive folder, and share
# that folder with the service account's email (Editor access). See README.
GOOGLE_SERVICE_ACCOUNT_KEY=""
# The folder ID from the Drive folder's URL: drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=""

# --- Email Reminder (optional for now) ---
# Get a free API key at https://resend.com — leave blank to run in
# "simulation mode" (reminders are checked and logged, but no email is sent).
RESEND_API_KEY=""
EMAIL_FROM="Certificate Reminder <onboarding@resend.dev>"
# Used to build the "view certificate" link inside reminder emails.
APP_URL="http://localhost:3000"
# Shared secret for external schedulers (Vercel Cron, OS cron via curl) to
# call POST /api/reminders/run without a logged-in session. Optional —
# reminders can also be triggered manually from the Dashboard as Admin.
CRON_SECRET=""
